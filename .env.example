# Resend email integration for the lead form.
# Copy to .env for local dev, and set these in Railway (Variables) for production.

# Required. Create in Resend › API Keys.
# NOTE: a "Sending"-only key can email but CANNOT save contacts. Use a
# Full-access key so each lead is also stored as a Resend contact (with phone).
RESEND_API_KEY=

# Segment new contacts are added to (the "Website leads" segment).
LEAD_SEGMENT_ID=d7334c7f-8e7c-4822-aa56-29d6c1a2c5d8

# Where lead notifications are delivered.
# NOTE: while using the onboarding sender below (no verified domain yet), Resend
# only delivers to the email address your Resend ACCOUNT itself is registered
# under — sending to a different address will silently fail. If your Resend
# account isn't stefkeppens@gmail.com, either use that account's own email
# here, or verify a domain in Resend first so LEAD_FROM can be a real address.
LEAD_TO=stefkeppens@gmail.com

# "From" address for the notification. Until you verify a domain in Resend, use
# the onboarding sender below (it only delivers to LEAD_TO when that is your own
# account email). After verifying a domain, switch to e.g.
# "Stef Keppens <stef@stefkeppens.be>".
LEAD_FROM=Stef Keppens website <onboarding@resend.dev>

# Optional confirmation reply to the person who submitted the form.
# Requires a VERIFIED domain, since it delivers to arbitrary addresses.
# LEAD_AUTOREPLY=true
# LEAD_REPLY_FROM=Stef Keppens <stef@stefkeppens.be>

# Optional: also upsert each lead as a HubSpot contact (by email).
# Create in HubSpot › Settings › Integrations › Private Apps, with the
# crm.objects.contacts.write scope. Leads still send via Resend above if
# this is left empty.
HUBSPOT_ACCESS_TOKEN=
